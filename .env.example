# Copy this file to ".env" and fill in your real values. Never commit .env.

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# WooCommerce REST API (WooCommerce > Settings > Advanced > REST API > Add key)
# Give the key "Read/Write" permissions. Your store must be on HTTPS.
WC_STORE_URL=http://192.168.1.12
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local server port
PORT=5000
